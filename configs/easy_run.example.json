{
  "schema_version": 1,
  "data": {
    "folder": "data",
    "manifest": "SHA256SUMS"
  },
  "inputs": {
    "tokenizer": "<tokenizer folder inside data/>",
    "corpus": [
      "<training token corpus folder>=<sampling weight>"
    ],
    "instructions": "<training instruction JSONL>",
    "pairs": "<training embedding pair JSONL>"
  },
  "holdouts": {
    "valid": {
      "corpus": [
        "<validation token corpus folder>"
      ],
      "instructions": "<validation instruction JSONL>",
      "pairs": "<validation pair JSONL>"
    },
    "test": {
      "corpus": [
        "<test token corpus folder>"
      ],
      "instructions": "<test instruction JSONL>",
      "pairs": "<test pair JSONL>"
    }
  },
  "evaluation": {
    "eval_corpus": "<validation token corpus folder used by scripts/evaluate.py>",
    "eval_pairs": "<validation pair JSONL used by scripts/evaluate.py>"
  },
  "budget": {
    "total_hours": 168,
    "package_hours": 1,
    "reserve_hours": 1,
    "safety": 0.95,
    "max_epochs": 3,
    "shares": {
      "base-dense": 50,
      "base-moe": 30,
      "it-dense": 8,
      "it-moe": 6,
      "embed": 6
    }
  },
  "train": {
    "batch_size": 64,
    "embed_batch_size": 128,
    "save_every_minutes": 30,
    "validations_per_stage": 20
  },
  "recipes": {
    "base": {
      "span_end_prob": 0.5,
      "r_dropout_prob": 0.5
    },
    "it": {
      "span_end_prob": 0.5
    }
  }
}
