{
  "status": "architecture_proposal_not_executable_training_config",
  "architecture_name": "nuri_bidirectional_latent_reasoning_v0",
  "goals": [
    "embedding",
    "retrieval",
    "classification",
    "bounded_conditional_generation"
  ],
  "hardware_assumption": {
    "gpu_count": 1,
    "candidates": [
      "A100 80GB",
      "H100 variant unspecified"
    ],
    "training_wall_hours": 24,
    "throughput_and_batch_size": "measure_before_setting"
  },
  "reference_model": {
    "initialization": "scratch_pilot",
    "vocab_size": 32768,
    "tokenizer": "undecided_reference_size_only",
    "hidden_size": 512,
    "attention_heads": 8,
    "kv_heads": 8,
    "head_dim": 64,
    "ffn_intermediate_size": 1408,
    "ffn": "swiglu",
    "norm": "rmsnorm",
    "norm_eps": 1e-06,
    "linear_bias": false,
    "tie_token_embedding_and_vocab_head": true,
    "dropout": 0.0
  },
  "input_encoder": {
    "layers": 6,
    "max_input_tokens": 512,
    "attention": "global_bidirectional_mha",
    "position": "rope_on_self_attention_qk",
    "rope_theta_candidate": 10000,
    "final_norm": true,
    "read_only_during_reasoning_and_refinement": true,
    "detach_input_memory": false,
    "pretrained_backbone_variant": "preserve_original_backbone_geometry_and_recalculate_budget"
  },
  "reasoning_core": {
    "latent_slots": 16,
    "distinct_learned_slot_initialization": true,
    "blocks": 1,
    "share_entire_block_across_steps": true,
    "training_steps": 4,
    "evaluation_steps": [
      1,
      2,
      4,
      8,
      16
    ],
    "operations": [
      "pre_norm_cross_read_input",
      "pre_norm_bidirectional_latent_self_attention",
      "pre_norm_swiglu"
    ],
    "cache_input_kv_with_gradient": true,
    "latent_rope": false,
    "cross_attention_rope": false,
    "step_embedding": false,
    "task_embedding": false,
    "branch_gate": "shared_sigmoid_scalar_per_branch",
    "branch_gate_initial_value": 0.1,
    "branch_gate_raw_logit_initial_value": -2.197224577,
    "final_readout_norm": true,
    "recurrent_state_uses_final_readout_norm": false
  },
  "embedding": {
    "dimension": 256,
    "pooling": "masked_mean_input_and_mean_latents",
    "fast_mode": "l2_normalize(P(pool_X))",
    "reasoning_mode": "l2_normalize(P(pool_X_plus_Wr_pool_R))",
    "query_document_default": "same_mode",
    "cross_mode_alignment": "required_before_mixed_mode_retrieval",
    "contrastive_training": "supervised_pairs_preferred",
    "unsupervised_simcse_variant": "enable_independent_dropout_views_separately"
  },
  "generation": {
    "readout_layers": 2,
    "share_readout_across_refinement_rounds": true,
    "share_with_input_encoder_or_reasoning_core": false,
    "memory": [
      "input_X",
      "final_reasoning_R"
    ],
    "operations": [
      "pre_norm_bidirectional_canvas_self_attention_with_rope",
      "pre_norm_memory_cross_attention_without_rope",
      "pre_norm_swiglu"
    ],
    "final_norm": true,
    "recompute_X_or_R_each_refinement_round": false,
    "cache_memory_kv_per_readout_layer": true,
    "cache_canvas_self_attention_kv_between_rounds": false,
    "max_response_tokens_including_eos": 64,
    "length_head_input": "concat_pool_X_pool_R",
    "length_class_range_including_eos": {
      "min": 1,
      "max": 64
    },
    "train_canvas_length": "gold_length_implicit_conditioning",
    "inference_canvas_length": "it_predicted_length_argmax_base_explicit_canvas_len",
    "length_loss_supervision": "it_natural_instruction_responses_only_not_random_spans",
    "generation_loss_batch_reduction": "mean_of_per_sample_masked_position_mean_ce",
    "objective": "conditional_masked_denoising_not_diffusion_elbo",
    "full_mask_probability": 0.1,
    "other_mask_ratio_uniform": [
      0.15,
      0.95
    ],
    "minimum_masked_positions": 1,
    "loss_positions": "masked_response_positions_including_eos",
    "training_corruptions_per_sample": 1,
    "training_refinement_unroll": false,
    "refinement_rounds": 4,
    "evaluation_refinement_rounds": [
      1,
      2,
      4,
      8
    ],
    "token_selection": "greedy",
    "remask_policy": "lowest_stored_last_masked_prediction_confidence",
    "after_round_s_remask_count": "ceil(output_length*(rounds-s)/rounds)",
    "early_stop_on_intermediate_eos": false,
    "final_eos_handling": "trim_at_first_eos_and_record_eos_failures"
  },
  "training_mix_candidate": {
    "mlm_text": 0.3,
    "supervised_embedding_pairs": 0.3,
    "short_instruction_denoising": 0.25,
    "structured_reasoning_tasks": 0.15,
    "task_loss_weight_within_batch": 1.0,
    "length_loss_weight_within_generation_batch": 0.1,
    "reasoning_validation_head": "R_only",
    "one_batch_one_task_type": true
  },
  "optional_features_disabled_by_default": {
    "moe": {
      "enabled": false,
      "input_layers_one_based": [
        3,
        6
      ],
      "experts": 4,
      "top_k": 2,
      "expert_intermediate_size": 1408,
      "routing": "dropless_tokenwise_normalized_selected_weights",
      "router_precision": "fp32",
      "load_balance_loss": "calibrate_weight_from_logs",
      "router_z_loss": "calibrate_weight_from_logs"
    },
    "local_global_attention": {
      "enabled": false,
      "input_layer_schedule": [
        "global",
        "local",
        "local",
        "global",
        "local",
        "global"
      ],
      "local_radius": 64,
      "maximum_interior_local_keys": 129
    },
    "qk_norm": false,
    "gqa": false,
    "mla": false,
    "adaptive_halting": false,
    "random_depth_training": {
      "enabled": false,
      "depths": [
        2,
        4,
        8
      ]
    },
    "intermediate_answer_supervision": false,
    "forced_state_change_loss": false,
    "monotonic_confidence_loss": false,
    "draft_feedback_to_reasoning": false,
    "matryoshka_embeddings": {
      "enabled": false,
      "dimensions": [
        64,
        128,
        256
      ]
    },
    "hypothesis_slot_groups": {
      "enabled": false,
      "groups": 4
    },
    "diffusion_objective_and_sampler": false
  },
  "implemented_experiment_contracts": {
    "gqa": {
      "model_field": "num_kv_heads",
      "default": null,
      "cache": "reduced_kv_heads",
      "quality_and_gpu_speed": "unmeasured"
    },
    "native_gqa_runtime": {
      "default": false,
      "model_method": "set_native_gqa",
      "training_and_benchmark_flag": "--native-gqa",
      "portable_fallback": "explicit_kv_head_repetition",
      "resume_setting": "native_gqa_legacy_default_false",
      "fused_kernel_guaranteed": false
    },
    "latent_kv_projection": {
      "model_field": "kv_latent_dim",
      "default": null,
      "projection": "shared_down_then_separate_k_and_v_up",
      "cache": "expanded_kv_not_latent_only"
    },
    "core_moe": {
      "model_field": "moe.core",
      "default": false,
      "step_counts": "core.last_step_expert_counts"
    },
    "hypothesis_slot_groups": {
      "model_field": "slot_groups",
      "default": 1,
      "attention": "within_groups_until_final_all_slot_merge"
    },
    "training_free_halting": {
      "api_argument": "halt_tol",
      "default": null,
      "relative_update_norm_dtype": "float32",
      "reject_nan_or_negative": true,
      "incompatible_with": ["return_states", "slot_groups_greater_than_one"],
      "zero": "full_scheduled_depth",
      "positive_infinity": "one_step_diagnostic"
    },
    "cross_mode_alignment": {
      "training_field": "cross_mode_weight",
      "default": 0.0,
      "objective": "reasoning_query_fast_document_infonce",
      "telemetry": "loss/pairs/cross_mode_unweighted_component"
    },
    "grouped_expert_runtime": {
      "model_field": "moe.backend",
      "default": "loop",
      "opt_in": "grouped",
      "fallback": "known_unavailable_kernels_only",
      "benchmark": "requested_and_successful_measured_paths_excluding_warmup",
      "gpu_speed": "unmeasured"
    },
    "draft_feedback": {
      "model_field": "draft_feedback",
      "default": false,
      "source": "input_X_and_current_corrupted_draft_embeddings",
      "hidden_targets": "mask_embeddings_only",
      "length_prediction": "separate_draft_free_reasoning",
      "round_update": "restart_from_learned_slots_and_rebuild_readout_kv",
      "generation_steps_reported": "sum_of_actual_steps_including_initial_call",
      "full_depth_generation_cost": "(S+1)*T_core_updates_per_sample"
    }
  },
  "private_data_layout": {
    "decision": "D-008 and D-015",
    "raw_prepared_tokens_downloads": "data/ (ignored)",
    "source_and_usage_records": ".private/ (ignored)",
    "source_input": "environment_or_private_plan_only",
    "imports": "independent_copies_read_only_sources",
    "prepared_fields": "task_content_only_no_provenance",
    "local_git_guard": "tools/check_private_files.py"
  },
