    "moe": {
      "base": "dense",
      "moe_layers": {
        "input_one_based": [
          2,
          4,
          6,
          8,
          10
        ],
        "readout_one_based": [
          2
        ]
      },
      "experts": 16,
      "expert_intermediate_size": 512,
      "top_k": 3,
